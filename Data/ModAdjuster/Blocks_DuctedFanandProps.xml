    <Definition xsi:type="MyObjectBuilder_ThrustDefinition">
      <Id>
        <TypeId>Thrust</TypeId>
        <SubtypeId>DuctedFan</SubtypeId>
      </Id>
      <DisplayName>Ducted Fan 7x7 (16t) (Shiny Blades)</DisplayName>
      <Icon>Textures\Icons\DuctedFan.png</Icon>
      <Description>A cheap but bulky thruster for VTOL enthusiasts. Not hugely tough and difficult to protect.</Description>
      <CubeSize>Small</CubeSize>
      <GuiVisible>false</GuiVisible>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="7" y="7" z="1"/>
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\DuctedFan.mwm</Model>
      <ThrusterType>Atmospheric</ThrusterType>
      <SilenceableByShipSoundSystem>false</SilenceableByShipSoundSystem>

      <BuildProgressModels>
        <Model BuildPercentUpperBound="1.00" File="Models\DuctedFan_BS1.mwm"/>
      </BuildProgressModels>

      <Components>
        <Component Subtype="SteelPlate" Count="12" />
        <Component Subtype="Construction" Count="13" />
        <Component Subtype="Motor" Count="4" />
        <Component Subtype="Construction" Count="2" />
        <Component Subtype="SteelPlate" Count="10" />
      </Components>
      <CriticalComponent Subtype="Motor" Index="0" />
      <MirroringX>Z</MirroringX>
      <MirroringZ>X</MirroringZ>
      <VoxelPlacement>
        <!--Possible settings Both,InVoxel,OutsideVoxel,Volumetric. If volumetric set than MaxAllowed and MinAllowed will be used.-->
        <StaticMode>
          <PlacementMode>Volumetric</PlacementMode>
          <MaxAllowed>0.2</MaxAllowed>
          <MinAllowed>0</MinAllowed>
        </StaticMode>
        <DynamicMode>
          <PlacementMode>Volumetric</PlacementMode>
          <MaxAllowed>0.2</MaxAllowed>
          <MinAllowed>0</MinAllowed>
        </DynamicMode>
      </VoxelPlacement>

      <BuildTimeSeconds>10</BuildTimeSeconds>
      <EdgeType>Light</EdgeType>

      <ResourceSinkGroup>Thrust</ResourceSinkGroup>
      <ForceMagnitude>207360</ForceMagnitude>
      <MaxPowerConsumption>0.25</MaxPowerConsumption>
      <MinPowerConsumption>0.000008</MinPowerConsumption>
      <SlowdownFactor>1</SlowdownFactor>

      <MinPlanetaryInfluence>0.3</MinPlanetaryInfluence>
      <MaxPlanetaryInfluence>1</MaxPlanetaryInfluence>
      <EffectivenessAtMinInfluence>0</EffectivenessAtMinInfluence>
      <EffectivenessAtMaxInfluence>1</EffectivenessAtMaxInfluence>
      <NeedsAtmosphereForInfluence>true</NeedsAtmosphereForInfluence>

      <PrimarySound>FanSound</PrimarySound>

      <FlameDamageLengthScale>0</FlameDamageLengthScale>
      <FlameLengthScale>3</FlameLengthScale>
      <FlameIdleColor>
        <X>0</X>
        <Y>0</Y>
        <Z>0</Z>
        <W>0</W>
      </FlameIdleColor>
      <FlameFullColor>
        <X>0</X>
        <Y>0</Y>
        <Z>0</Z>
        <W>0</W>
      </FlameFullColor>
      <FlamePointMaterial>EngineThrustMiddle</FlamePointMaterial>
      <FlameLengthMaterial>EngineThrustMiddle</FlameLengthMaterial>
      <FlameFlare>LargeGridSmallThruster</FlameFlare>
      <FlameVisibilityDistance>500</FlameVisibilityDistance>
      <FlameGlareQuerySize>1</FlameGlareQuerySize>
      <PropellerUsesPropellerSystem>true</PropellerUsesPropellerSystem>
      <PropellerSubpartEntityName>Propeller</PropellerSubpartEntityName>
      <PropellerRoundsPerSecondOnFullSpeed>1.5</PropellerRoundsPerSecondOnFullSpeed>
      <PropellerRoundsPerSecondOnIdleSpeed>0</PropellerRoundsPerSecondOnIdleSpeed>
      <PropellerAccelerationTime>4</PropellerAccelerationTime>
      <PropellerDecelerationTime>1</PropellerDecelerationTime>
      <PropellerMaxVisibleDistance>2000</PropellerMaxVisibleDistance>



      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleWeapExpl</DamagedSound>
      <Public>true</Public>
      <DestroyEffect>BlockDestroyedExplosion_Tiny</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>15</PCU>
      <GeneralDamageMultiplier>0.5</GeneralDamageMultiplier>
      <IsAirTight>false</IsAirTight>
      <TieredUpdateTimes>
        <unsignedInt>100</unsignedInt>
        <unsignedInt>3600</unsignedInt>
        <unsignedInt>0</unsignedInt>
      </TieredUpdateTimes>

	<BlockVariants>
           
        <BlockVariant>
          <TypeId>Thrust</TypeId>
          <SubtypeId>DuctedFanSmall</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>Thrust</TypeId>
          <SubtypeId>DuctedFanAlternate</SubtypeId>
        </BlockVariant>
	<BlockVariant>
          <TypeId>Thrust</TypeId>
          <SubtypeId>DuctedFanSmallAlternate</SubtypeId>
        </BlockVariant>
 
      </BlockVariants>

    </Definition>









