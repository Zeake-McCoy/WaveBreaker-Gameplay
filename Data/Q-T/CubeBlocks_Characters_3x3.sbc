    <CubeBlocks>
        <Definition>
            <Id>
                <TypeId>CubeBlock</TypeId>
                <SubtypeId>Characters_A_3x3_Large</SubtypeId>
            </Id>
            <DisplayName>Characters 3x3</DisplayName>
            <Icon>Textures\GUI\Icons\Characters\Characters_A.dds</Icon>
            <Description>A set of Tritanium character panels for ship names and registry numbers.</Description>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="3" y="3" z="1" />
            <ModelOffset x="0" y="0" z="0" />
            <Model>Models\Characters\LG_Characters_A_3x3.mwm</Model>
            <Components>
                <Component Subtype="SteelPlate" Count="4" />
                <Component Subtype="SteelPlate" Count="1" />
            </Components>
            <CriticalComponent Subtype="SteelPlate" Index="1" />
            <BuildProgressModels>
				<Model BuildPercentUpperBound="1.00" File="Models\Characters\LG_Characters_BS_3x3.mwm"/>
			</BuildProgressModels>
            <MountPoints>
                <MountPoint Side="Back" StartX="0" StartY="0" EndX="3" EndY="3" />
            </MountPoints>
            <BlockPairName>Characters_A_3x3</BlockPairName>
            <MirroringY>X</MirroringY>
			<MirroringZ>Y</MirroringZ>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>6</BuildTimeSeconds>
            <DisassembleRatio>2</DisassembleRatio>
            <PCU>1</PCU>
        </Definition>

