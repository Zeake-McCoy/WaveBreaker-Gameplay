<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
    <Definition xsi:type="MyObjectBuilder_RadioAntennaDefinition">
      <Id>
        <TypeId>RadioAntenna</TypeId>
        <SubtypeId>Deflector_MK1</SubtypeId>
      </Id>
      <DisplayName>Deflector MK1</DisplayName>
      <Icon>Textures\GUI\Icons\Deflector\Deflector_Blue.dds</Icon>
      <Description>Deflector MK1. One block wide antenna dish.</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Deflector\Deflector_MK1.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="80" />
        <Component Subtype="LargeTube" Count="25" />
        <Component Subtype="SmallTube" Count="35" />
        <Component Subtype="Construction" Count="25" />
        <Component Subtype="Computer" Count="4" />
        <Component Subtype="RadioCommunication" Count="25" />
      </Components>
      <CriticalComponent Subtype="RadioCommunication" Index="0" />
      <BuildProgressModels>
				<Model BuildPercentUpperBound="1.00" File="Models\Deflector\Deflector_MK1_BS1.mwm"/>
			</BuildProgressModels>
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00" />
      </MountPoints>
      <BlockPairName>Deflector_MK1</BlockPairName>
      <MaxBroadcastRadius>500000</MaxBroadcastRadius>
      <EdgeType>Light</EdgeType>
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <BuildTimeSeconds>40</BuildTimeSeconds>
      <MirroringY>X</MirroringY>
      <DamageEffectName>Damage_Electrical_Damaged_Antenna</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>50</PCU>
      <IsAirTight>false</IsAirTight>
    </Definition>

