	  <Definition xsi:type="MyObjectBuilder_TextPanelDefinition">
		  <Id>
			  <TypeId>TextPanel</TypeId>
			  <SubtypeId>ASL_AircraftControlHUD</SubtypeId>
		  </Id>
		  <DisplayName>Aircraft Control HUD</DisplayName>
		  <Description>
			  HUD for use with Aircraft control seat
		  </Description>
		  <Icon>Models\Textures\GUI\Icons\Cubes\ASL_AircraftControlHUD.dds</Icon>
		  <CubeSize>Large</CubeSize>
		  <BlockTopology>TriangleMesh</BlockTopology>
		  <Size x="1" y="1" z="1"/>
		  <ModelOffset x="0" y="0" z="0"/>
		  <Model>Models\Models\Cubes\Large\ASL_AircraftControlHUD.mwm</Model>
		  <Components>
			  <Component Subtype="Construction" Count="2" />
			  <Component Subtype="Computer" Count="2" />
			  <Component Subtype="Display" Count="2" />
			  <Component Subtype="BulletproofGlass" Count="1" />
		  </Components>
		  <CriticalComponent Subtype="Display" Index="0" />
		  <ScreenAreas>
			  <ScreenArea Name="TransparentScreenArea" DisplayName="TransparentScreenArea" TextureResolution="512" ScreenWidth="1" ScreenHeight="1" />
		  </ScreenAreas>

		  <BuildProgressModels>
			  <Model BuildPercentUpperBound="1.00" File="Models\Models\Cubes\Large\ASL_AircraftControlHUD.mwm"/>

		  </BuildProgressModels>
		  <MirroringY>Z</MirroringY>
		  <MirroringZ>Y</MirroringZ>

		  <BlockPairName>ASL_AircraftControlHUD</BlockPairName>
		  <HasInventory>false</HasInventory>
		  <BuildTimeSeconds>3</BuildTimeSeconds>
		  <MaxScreenRenderDistance>60</MaxScreenRenderDistance>
		  <ResourceSinkGroup>Utility</ResourceSinkGroup>
		  <RequiredPowerInput>0.00002</RequiredPowerInput>
		  <PanelMaterialName>TransparentScreenArea</PanelMaterialName>
		  <PCU>10</PCU>
		  <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
		  <DamagedSound>ParticleElectrical</DamagedSound>
	  </Definition>

