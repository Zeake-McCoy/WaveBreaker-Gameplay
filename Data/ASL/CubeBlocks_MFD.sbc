<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>

	  <!-- MDF-->
	  
	  
	  <Definition xsi:type="MyObjectBuilder_ProgrammableBlockDefinition">
		  <Id>
			  <TypeId>MyProgrammableBlock</TypeId>
			  <SubtypeId>ASL_FIS_BF109</SubtypeId>
		  </Id>
		  <DisplayName>Flight Instrument System BF-109(Programmable Block)</DisplayName>
		  <Description>
			  
		  </Description>
		  <Icon>Models\Textures\GUI\Icons\Cubes\ASL_FIS_BF109.dds</Icon>
		  <CubeSize>Small</CubeSize>
		  <BlockTopology>TriangleMesh</BlockTopology>
		  <Size x="1" y="1" z="1"/>
		  <ModelOffset x="0" y="0" z="0"/>
		  <Model>Models\Models\Cubes\small\ASL_FIS_BF109.mwm</Model>
		  <Components>
			  <Component Subtype="InteriorPlate" Count="2" />
			  <Component Subtype="Construction" Count="2" />
			  <Component Subtype="Computer" Count="4" />
			  <Component Subtype="Display" Count="3" />
			  <Component Subtype="Construction" Count="2" />
		  </Components>
		  <CriticalComponent Subtype="Display" Index="0" />
		  <BuildProgressModels>
			  <Model BuildPercentUpperBound="1.00" File="Models\Models\Cubes\small\ASL_FIS_BF109.mwm"/>
		  </BuildProgressModels>
		  <BlockPairName>ASL_FIS_BF109</BlockPairName>
		  <ScreenAreas>
			  <ScreenArea Name="CockpitScreen_01" DisplayName="Central Top Screen" TextureResolution="512" ScreenWidth="5" ScreenHeight="3" />
			  <ScreenArea Name="CockpitScreen_02" DisplayName="Central Bottom Screen" TextureResolution="512" ScreenWidth="2" ScreenHeight="1" />
			  <ScreenArea Name="CockpitScreen_03" DisplayName="Left Bottom Screen" TextureResolution="512" ScreenWidth="1" ScreenHeight="1" />
			  <ScreenArea Name="CockpitScreen_04" DisplayName="Right Bottom Screen" TextureResolution="512" ScreenWidth="1" ScreenHeight="1" />
			  <ScreenArea Name="CockpitScreen_05" DisplayName="Left Top Screen" TextureResolution="512" ScreenWidth="1" ScreenHeight="1" />
		  </ScreenAreas>
		  <BuildTimeSeconds>8</BuildTimeSeconds>

		  <MirroringZ>Y</MirroringZ>
		  <ResourceSinkGroup>Utility</ResourceSinkGroup>
		  <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
		  <DamagedSound>ParticleElectrical</DamagedSound>
		  <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
		  <DestroySound>WepSmallWarheadExpl</DestroySound>
		  <PCU>20</PCU>
		  <UseModelIntersection>true</UseModelIntersection>
	  </Definition>		  

	  <!-- HUD-->

	  <Definition xsi:type="MyObjectBuilder_TextPanelDefinition">
		  <Id>
			  <TypeId>TextPanel</TypeId>
			  <SubtypeId>ASL_CanopyFrontFrameHUD</SubtypeId>
		  </Id>
		  <DisplayName>Canopy Front Frame HUD</DisplayName>
		  <Description>
			  Canopy HUD
		  </Description>
		  <Icon>Models\Textures\GUI\Icons\Cubes\ASL_CanopyFrontFrameHUD.dds</Icon>
		  <CubeSize>Small</CubeSize>
		  <BlockTopology>TriangleMesh</BlockTopology>
		  <Size x="1" y="1" z="1"/>
		  <ModelOffset x="0" y="0" z="0"/>
		  <Model>Models\Models\Cubes\small\ASL_CanopyFrontFrameHUD.mwm</Model>
		  <Components>
			  <Component Subtype="Construction" Count="2" />
			  <Component Subtype="Computer" Count="2" />
			  <Component Subtype="Display" Count="2" />
			  <Component Subtype="BulletproofGlass" Count="1" />
		  </Components>
		  <CriticalComponent Subtype="Display" Index="0" />
		  <ScreenAreas>
			  <ScreenArea Name="TransparentScreenArea" DisplayName="TransparentScreenArea" TextureResolution="512" ScreenWidth="1" ScreenHeight="1" />
		  </ScreenAreas>

		  <BuildProgressModels>
			  <Model BuildPercentUpperBound="1.00" File="Models\Models\Cubes\small\ASL_CanopyFrontFrameHUD.mwm"/>

		  </BuildProgressModels>
		  <MirroringY>Z</MirroringY>
		  <MirroringZ>Y</MirroringZ>

		  <BlockPairName>ASL_CanopyFrontFrameHUD</BlockPairName>
		  <HasInventory>false</HasInventory>
		  <BuildTimeSeconds>3</BuildTimeSeconds>
		  <MaxScreenRenderDistance>60</MaxScreenRenderDistance>
		  <ResourceSinkGroup>Utility</ResourceSinkGroup>
		  <RequiredPowerInput>0.00002</RequiredPowerInput>
		  <PanelMaterialName>TransparentScreenArea</PanelMaterialName>
		  <PCU>10</PCU>
		  <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
		  <DamagedSound>ParticleElectrical</DamagedSound>
	  </Definition>
			  
			  

