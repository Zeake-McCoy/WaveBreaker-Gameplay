	  <Definition xsi:type="MyObjectBuilder_ReflectorBlockDefinition">
		  <Id>
			  <TypeId>ReflectorLight</TypeId>
			  <SubtypeId>ASL_TankLight</SubtypeId>
		  </Id>
		  <DisplayName>Tank Light</DisplayName>
		  <Icon>Models\Textures\GUI\Icons\Cubes\ASL_TankLight.dds</Icon>
		  <Description>
			  Tank Light
		  </Description>
		  <CubeSize>Small</CubeSize>
		  <GuiVisible>false</GuiVisible>
		  <BlockTopology>TriangleMesh</BlockTopology>
		  <Size x="1" y="1" z="1" />
		  <ModelOffset x="0" y="0" z="0" />
		  <Model>Models\Models\Cubes\Small\ASL_TankLight.mwm</Model>
		  <Components>
			  <Component Subtype="Construction" Count="1" />
			  <Component Subtype="BulletproofGlass" Count="1" />
		  </Components>
		  <CriticalComponent Subtype="BulletproofGlass" Index="0" />
		  <IsStandAlone>false</IsStandAlone>
		  <HasPhysics>false</HasPhysics>
		  <BuildProgressModels>
			  <Model BuildPercentUpperBound="1.00" File="Models\Models\Cubes\Small\ASL_TankLight.mwm" />
		  </BuildProgressModels>
		  <BlockPairName>ASL_TankLight</BlockPairName>
		  <MirroringZ>Y</MirroringZ>
		  <EdgeType>Light</EdgeType>
		  <BuildTimeSeconds>4</BuildTimeSeconds>
		  <LightRadius Min="1" Max="5" Default="5" />
		  <LightReflectorRadius Min="10" Max="60" Default="60" />
		  <LightFalloff Min="1" Max="3" Default="1.5" />
		  <LightIntensity Min="0.5" Max="5" Default="3" />
		  <ResourceSinkGroup>Utility</ResourceSinkGroup>
		  <RequiredPowerInput>0.0002</RequiredPowerInput>
		  <Flare>SpotlightSmall</Flare>
		  <PointLightEmissiveMaterial>Emissive</PointLightEmissiveMaterial>
		  <SpotLightEmissiveMaterial>EmissiveSpotlight</SpotLightEmissiveMaterial>
		  <ReflectorThickness>2.5</ReflectorThickness>
		  <ReflectorTexture>Textures\Lights\reflector_CarLight.dds</ReflectorTexture>
		  <ReflectorConeDegrees>52</ReflectorConeDegrees>
		  <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
		  <DamagedSound>ParticleElectrical</DamagedSound>
		  <DestroyEffect>BlockDestroyed_Medium</DestroyEffect>
		  <DestroySound>PoofExplosionCat2</DestroySound>
		  <PCU>1</PCU>
		  <IsAirTight>false</IsAirTight>

	  </Definition>

