<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
	  


	  	  <!-- Slope-->




	          <Definition>
            <Id>
                <TypeId>CubeBlock</TypeId>
                <SubtypeId>RHSH_SmallBlockArmorBlock_Slope_3x1</SubtypeId>
            </Id>
            <DisplayName>RHSH_ArmorBlock Slope 3x1</DisplayName>
		  <Icon>Models\Textures\GUI\Icons\Cubes\ASL_lightArmor_Slope_3x1.dds</Icon>
            <Description>Rolled homogenous steel armor, far stronger than the original heavy armor, but only slightly heavier than light armor</Description>
            <CubeSize>Small</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="1" y="1" z="3" />
            <ModelOffset x="0" y="0" z="0" />
			<Model>Models\Models\Cubes\small\ASL_lightArmor_Slope_3x1.mwm</Model>
			<PhysicsOption>Convex</PhysicsOption>
            <Components>
                <Component Subtype="RHSH_Plate" Count="3" />
            </Components>
            <CriticalComponent Subtype="RHSH_Plate" Index="0" />

            <BuildProgressModels>
				<Model BuildPercentUpperBound="1.00" File="Models\Models\Cubes\small\ASL_lightArmor_Slope_3x1.mwm"/>

            </BuildProgressModels>

            <BlockPairName>RHSH_ArmorBlockSlope_3x1</BlockPairName>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
            <BuildTimeSeconds>9</BuildTimeSeconds>
            <DisassembleRatio>2.5</DisassembleRatio>
            <EdgeType>Light</EdgeType>
            <PCU>1</PCU>
            <PCUConsole>2</PCUConsole>
            <IsAirTight>true</IsAirTight>
        </Definition>
	  
