  <CubeBlocks>

		  <Definition>
		  <Id>
			  <TypeId>CubeBlock</TypeId>
			  <SubtypeId>Ceramic_ArmorSlope_ERA</SubtypeId>
		  </Id>
		  <DisplayName>Ceramic ArmorSlope (ERA)</DisplayName>
		  <Icon>Models\Textures\GUI\Icons\Cubes\Ceramic_ArmorSlope_ERA.dds</Icon>
		  <Description>
			ERA shaped armor, slightly stronger than ordinary Ceramic, but lighter
		  </Description>
		  <CubeSize>Small</CubeSize>
		  <BlockTopology>TriangleMesh</BlockTopology>
		  <Size x="1" y="1" z="1" />
		  <ModelOffset x="0" y="0" z="0" />
		  <Model>Models\Models\Cubes\small\Ceramic_ArmorSlope_ERA.mwm</Model>
		  <Components>
				<Component Subtype="SteelPlate" Count="3" />
				<Component Subtype="Construction" Count="1" />
				<Component Subtype="KGS_ERA_Layer" Count="2" />
				<Component Subtype="SteelPlate" Count="2" />
		  </Components>
		  <CriticalComponent Subtype="KGS_ERA_Layer" Index="0" />
		  <BuildProgressModels>
			  <Model BuildPercentUpperBound="1.00" File="Models\Models\Cubes\small\Ceramic_ArmorSlope_ERA.mwm"/>
		  </BuildProgressModels>

		  <BlockPairName>Ceramic_ArmorSlope_ERA</BlockPairName>
		  <EdgeType>Light</EdgeType>
		  <BuildTimeSeconds>2</BuildTimeSeconds>
		  <DisassembleRatio>2.5</DisassembleRatio>
		  <NavigationDefinition>Default</NavigationDefinition>
		  <MirroringY>Z</MirroringY>
		  <MirroringZ>Y</MirroringZ>
		  <PCU>1</PCU>
		  <PCUConsole>2</PCUConsole>
	  </Definition>	  
	  
