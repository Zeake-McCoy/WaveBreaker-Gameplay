            <RequiredPowerInput>0.00003</RequiredPowerInput>
            <RequiredChargingInput>0.001</RequiredChargingInput>
            <OverlayTexture>Models\Textures\GUI\Screens\GunScopeNon.dds</OverlayTexture>
            <MinFov>-1.0</MinFov>
            <MaxFov>1</MaxFov>
            <RaycastConeLimit>0.0001</RaycastConeLimit>
