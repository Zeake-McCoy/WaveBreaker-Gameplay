	  <!-- Afterburner-->
	  
	  <Definition xsi:type="MyObjectBuilder_ThrustDefinition">
		  <Id>
			  <TypeId>Thrust</TypeId>
			  <SubtypeId>ASL_Afterburner_light</SubtypeId>
		  </Id>
		  <DisplayName>Afterburner light</DisplayName>
		  <Icon>Models\Textures\GUI\Icons\Cubes\ASL_Afterburner.dds</Icon>
		  <Description>
			  Thrusters with high hydrogen consumption in exchange for greater thrust, please place them in front of the 3X3 series thrusters
			  no thruster damage
			  The lightweight version has lower thrust, but the consumption is also reduced accordingly.
		  </Description>
		  <CubeSize>Small</CubeSize>
		  <BlockTopology>TriangleMesh</BlockTopology>
		  <Size x="1" y="1" z="1" />
		  <ModelOffset x="0" y="0" z="0" />
		  <Model>Models\Models\Cubes\small\ASL_Afterburner.mwm</Model>
		  <ThrusterType>Hydrogen</ThrusterType>
		  <SilenceableByShipSoundSystem>true</SilenceableByShipSoundSystem>
		  <Components>
			  <Component Subtype="SteelPlate" Count="3" />
			  <Component Subtype="Construction" Count="3" />
			  <Component Subtype="MetalGrid" Count="3" />
			  <Component Subtype="LargeTube" Count="2" />
			  <Component Subtype="Construction" Count="2" />
			  <Component Subtype="SteelPlate" Count="2" />
		  </Components>
		  <CriticalComponent Subtype="LargeTube" Index="0" />
		  <MountPoints>
			  <MountPoint Side="Top" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
			  <MountPoint Side="Front" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
			  <MountPoint Side="Back" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
			  <MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
			  <MountPoint Side="Right" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
			  <MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
		  </MountPoints>
		  <BuildProgressModels>
			  <Model BuildPercentUpperBound="1.00" File="Models\Models\Cubes\small\ASL_Afterburner.mwm"/>
		  </BuildProgressModels>
		  <VoxelPlacement>
			  <!--Possible settings Both,InVoxel,OutsideVoxel,Volumetric. If volumetric set than MaxAllowed and MinAllowed will be used.-->
			  <StaticMode>
				  <PlacementMode>OutsideVoxel</PlacementMode>
				  <MaxAllowed>0.2</MaxAllowed>
				  <MinAllowed>0</MinAllowed>
			  </StaticMode>
			  <DynamicMode>
				  <PlacementMode>OutsideVoxel</PlacementMode>
				  <MaxAllowed>0.2</MaxAllowed>
				  <MinAllowed>0</MinAllowed>
			  </DynamicMode>
		  </VoxelPlacement>
		  <BlockPairName>ASLAfterburner_light</BlockPairName>
		  <MirroringZ>Y</MirroringZ>
		  <EdgeType>Light</EdgeType>
		  <BuildTimeSeconds>20</BuildTimeSeconds>
		  <FuelConverter>
			  <FuelId>
				  <TypeId>GasProperties</TypeId>
				  <SubtypeId>Hydrogen</SubtypeId>
			  </FuelId>
			  <Efficiency>3</Efficiency>
		  </FuelConverter>
		  <MaxPowerConsumption>3</MaxPowerConsumption>
		  <MinPowerConsumption>0.000000001</MinPowerConsumption>
		  <ResourceSinkGroup>Thrust</ResourceSinkGroup>
		  <ForceMagnitude>300000</ForceMagnitude>
		  <SlowdownFactor>3</SlowdownFactor>
