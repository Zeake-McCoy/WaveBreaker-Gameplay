	  <Definition xsi:type="MyObjectBuilder_ThrustDefinition">
		  <Id>
			  <TypeId>Thrust</TypeId>
			  <SubtypeId>ASL_Afterburner_light_offset</SubtypeId>
		  </Id>
		  <DisplayName>Afterburner light offset</DisplayName>
		  <Icon>Models\Textures\GUI\Icons\Cubes\ASL_Afterburner.dds</Icon>
