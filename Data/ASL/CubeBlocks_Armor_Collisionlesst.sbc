	  <!-- Collisionlesst-->

	  <Definition>
		  <Id>
			  <TypeId>CubeBlock</TypeId>
			  <SubtypeId>SmallBlockArmorBlockCollisionlesst</SubtypeId>
		  </Id>
		  <DisplayName>Armor Block Collisionlesst</DisplayName>
		  <Icon>Textures\GUI\Icons\Cubes\light_armor_cube.dds</Icon>
		  <Description>
			  They have only minimal collision detection and can be used for decoration of mechanism.

		  </Description>
		  <IsStandAlone>false</IsStandAlone>
		  <HasPhysics>false</HasPhysics>
		  <CubeSize>Small</CubeSize>
		  <BlockTopology>TriangleMesh</BlockTopology>
		  <Size x="1" y="1" z="1" />
		  <ModelOffset x="0" y="0" z="0" />
		  <Model>Models\Models\Cubes\small\Collisionlesst_Armor_Block.mwm</Model>
		  <Components>
			  <Component Subtype="SteelPlate" Count="1" />
		  </Components>
		  <CriticalComponent Subtype="SteelPlate" Index="0" />

		  <BuildProgressModels>
			  <Model BuildPercentUpperBound="1.00" File="Models\Models\Cubes\small\Collisionlesst_Armor_Block.mwm"/>

		  </BuildProgressModels>

		  <BlockPairName>LightArmorBlockCollisionlesst</BlockPairName>
		  <DeformationRatio>0.32</DeformationRatio>
		  <BuildTimeSeconds>3</BuildTimeSeconds>
		  <DisassembleRatio>2.5</DisassembleRatio>
		  <EdgeType>Light</EdgeType>
		  <PCU>1</PCU>
		  <PCUConsole>2</PCUConsole>
		  <IsAirTight>false</IsAirTight>
	  </Definition>

