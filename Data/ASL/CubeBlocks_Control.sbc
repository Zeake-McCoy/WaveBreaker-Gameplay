			  <Component Subtype="Display" Count="4" />

		  </Components>
		  <CriticalComponent Subtype="Display" Index="0" />
		  <ScreenAreas>
			  <ScreenArea Name="CockpitScreen_01" DisplayName="Left_Screen_Large" TextureResolution="1024" ScreenWidth="1" ScreenHeight="1" Script="TSS_ArtificialHorizon" />
			  <ScreenArea Name="CockpitScreen_02" DisplayName="Central_Screen_Large" TextureResolution="1024" ScreenWidth="1" ScreenHeight="1" Script="TSS_EnergyHydrogen" />
			  <ScreenArea Name="CockpitScreen_03" DisplayName="Right_Screen_Large" TextureResolution="1024" ScreenWidth="1" ScreenHeight="1" Script="TSS_ClockDigital" />
		  
		  </ScreenAreas>
		  <BuildProgressModels>
