<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>


	          <Definition>
            <Id>
                <TypeId>CubeBlock</TypeId>
                <SubtypeId>ASL_SpruceTree</SubtypeId>
            </Id>
            <DisplayName>Spruce Tree</DisplayName>
		  <Icon>Models\Textures\GUI\Icons\Cubes\ASL_SpruceTree.dds</Icon>
            <Description>
				
		    </Description>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="1" y="11" z="1" />
            <ModelOffset x="0" y="0" z="0" />
			<Model>Models\Models\Cubes\Tree\ASL_SpruceTree.mwm</Model>
			<PhysicsOption>Convex</PhysicsOption>
            <Components>
                <Component Subtype="Construction" Count="10" />
            </Components>
            <CriticalComponent Subtype="Construction" Index="0" />

            <BuildProgressModels>
				<Model BuildPercentUpperBound="1.00" File="Models\Models\Cubes\Tree\ASL_SpruceTree.mwm"/>

            </BuildProgressModels>

            <BlockPairName>ASL_SpruceTree</BlockPairName>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
            <BuildTimeSeconds>9</BuildTimeSeconds>
            <DisassembleRatio>2.5</DisassembleRatio>
            <EdgeType>Light</EdgeType>
            <PCU>1</PCU>
            <PCUConsole>2</PCUConsole>
            <IsAirTight>true</IsAirTight>
        </Definition>

