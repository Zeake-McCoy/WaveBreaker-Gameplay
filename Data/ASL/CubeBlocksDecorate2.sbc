	  <Definition xsi:type="MyObjectBuilder_CockpitDefinition">
		  <Id>
			  <TypeId>Cockpit</TypeId>
			  <SubtypeId>ASL_PackBench</SubtypeId>
			  <!-- Flight seat -->
		  </Id>
		  <DisplayName>Pack Bench</DisplayName>
