		  <BlockTopology>TriangleMesh</BlockTopology>
		  <Size x="1" y="1" z="1" />
		  <ModelOffset x="0" y="0" z="0" />
		  <Model>Models\Models\Cubes\Large\ASL_PackBench.mwm</Model>
		  <PrimarySound>BlockCockpitFlightSeat</PrimarySound>
		  <CharacterAnimationMale>PassengerBench</CharacterAnimationMale>
		  <CharacterAnimationFemale>PassengerBenchFemale</CharacterAnimationFemale>
		  <UsesDeformation>false</UsesDeformation>
		  <Components>
			  <Component Subtype="SteelPlate" Count="3" />
		  </Components>
		  <CriticalComponent Subtype="InteriorPlate" Index="0" />

		  <BuildProgressModels>
			  <Model BuildPercentUpperBound="1.00" File="Models\Models\Cubes\Large\ASL_PackBench.mwm" />
		  </BuildProgressModels>
		  <VoxelPlacement>
			  <StaticMode>
				  <PlacementMode>OutsideVoxel</PlacementMode>
				  <MaxAllowed>0.2</MaxAllowed>
				  <MinAllowed>0</MinAllowed>
			  </StaticMode>
			  <DynamicMode>
				  <PlacementMode>OutsideVoxel</PlacementMode>
				  <MaxAllowed>0.2</MaxAllowed>
				  <MinAllowed>0</MinAllowed>
			  </DynamicMode>
		  </VoxelPlacement>
		  <BlockPairName>ASL_PackBench</BlockPairName>
		  <EdgeType>Light</EdgeType>
		  <BuildTimeSeconds>30</BuildTimeSeconds>
		  <MirroringZ>Y</MirroringZ>
		  <MirroringY>Z</MirroringY>
		  <EnableFirstPerson>true</EnableFirstPerson>
		  <EnableShipControl>false</EnableShipControl>
		  <EnableBuilderCockpit>false</EnableBuilderCockpit>
		  <TargetLockingEnabled>false</TargetLockingEnabled>
		  <IsPressurized>false</IsPressurized>
		  <HasInventory>false</HasInventory>
		  <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
		  <DamagedSound>ParticleElectrical</DamagedSound>
		  <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
		  <DestroySound>WepSmallWarheadExpl</DestroySound>
		  <RaycastOffset>
			  <X>0.016</X>
			  <Y>0.4983</Y>
			  <Z>0.15</Z>
		  </RaycastOffset>
		  <PCU>1</PCU>
		  <IsAirTight>false</IsAirTight>
	  </Definition>


