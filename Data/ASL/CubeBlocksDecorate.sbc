	          <Definition>
            <Id>
                <TypeId>CubeBlock</TypeId>
                <SubtypeId>ASL_FallSafetyNet</SubtypeId>
            </Id>
            <DisplayName>Fall Safety Net</DisplayName>
		  <Icon>Models\Textures\GUI\Icons\Cubes\FallSafetyNet.dds</Icon>
            <Description>
				
		    </Description>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="1" y="1" z="1" />
            <ModelOffset x="0" y="0" z="0" />
			<Model>Models\Models\Cubes\Large\FallSafetyNet.mwm</Model>
			<PhysicsOption>Convex</PhysicsOption>
            <Components>
                <Component Subtype="SteelPlate" Count="1" />
            </Components>
            <CriticalComponent Subtype="SteelPlate" Index="0" />
            <MountPoints>
				<MountPoint Side="Front" StartX="0.00" StartY="0.01" EndX="1.00" EndY="0.05"/>
				<MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="1.00" EndY="0.05"/>
				<MountPoint Side="Right" StartX="0.00" StartY="0.00" EndX="1.00" EndY="0.05"/>
            </MountPoints>
            <BuildProgressModels>
				<Model BuildPercentUpperBound="1.00" File="Models\Models\Cubes\Large\FallSafetyNet.mwm"/>

            </BuildProgressModels>

            <BlockPairName>ASL_FallSafetyNet</BlockPairName>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
            <BuildTimeSeconds>9</BuildTimeSeconds>
            <DisassembleRatio>2.5</DisassembleRatio>
            <EdgeType>Light</EdgeType>
            <PCU>1</PCU>
            <PCUConsole>2</PCUConsole>
            <IsAirTight>false</IsAirTight>
        </Definition>
	  
