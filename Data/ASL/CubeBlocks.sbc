<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
	  
	  <Definition xsi:type="MyObjectBuilder_GyroDefinition">
		  <Id>
			  <TypeId>Gyro</TypeId>
			  <SubtypeId>ASL_Rudder</SubtypeId>
		  </Id>
		  <DisplayName>Rudder (Gyro)</DisplayName>
		  <Icon>Models\Textures\GUI\Icons\Cubes\ASL_Rudder.dds</Icon>
		  <Description>Gyroscope</Description>
		  <CubeSize>Large</CubeSize>
		  <BlockTopology>TriangleMesh</BlockTopology>
		  <Size x="1" y="1" z="1" />
		  <ModelOffset x="0" y="0" z="0" />
		  <Model>Models\Models\Cubes\Large\ASL_Rudder.mwm</Model>
		  <SilenceableByShipSoundSystem>true</SilenceableByShipSoundSystem>
		  <Components>
			  <Component Subtype="SteelPlate" Count="5" />
			  <Component Subtype="Construction" Count="5" />
			  <Component Subtype="LargeTube" Count="1" />
			  <Component Subtype="Motor" Count="2" />
			  <Component Subtype="Computer" Count="3" />
			  <Component Subtype="SteelPlate" Count="1" />
		  </Components>
		  <CriticalComponent Subtype="Computer" Index="0" />

		  <BuildProgressModels>
			  <Model BuildPercentUpperBound="1.00" File="Models\Models\Cubes\Large\ASL_Rudder.mwm"/>
		  </BuildProgressModels>
		  <BlockPairName>ASL_Rudder</BlockPairName>
		  <MirroringY>Z</MirroringY>
		  <MirroringZ>Y</MirroringZ>
		  <BuildTimeSeconds>14</BuildTimeSeconds>
		  <EdgeType>Light</EdgeType>
		  <PrimarySound>BlockGyroscope</PrimarySound>

		  <ResourceSinkGroup>Gyro</ResourceSinkGroup>
		  <ForceMagnitude>436000000</ForceMagnitude>
		  <RequiredPowerInput>0.1</RequiredPowerInput>

		  <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
		  <DamagedSound>ParticleHeavyMech</DamagedSound>
		  <EmissiveColorPreset>Extended</EmissiveColorPreset>
		  <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
		  <DestroySound>WepSmallWarheadExpl</DestroySound>
		  <PCU>50</PCU>
		  <IsAirTight>true</IsAirTight>
		  <TargetingGroups>
			  <string>Propulsion</string>
		  </TargetingGroups>
	  </Definition>
	  
