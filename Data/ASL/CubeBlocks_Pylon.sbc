	  <Definition>
		  <Id>
			  <TypeId>Conveyor</TypeId>
			  <SubtypeId>ASL_PylonUS_Conveyor</SubtypeId>
		  </Id>
		  <DisplayName>Pylon F-16 Conveyor</DisplayName>
		  <Icon>Models\Textures\GUI\Icons\Cubes\PylonUS.dds</Icon>
		  <Description>
			  F-16 style pylons (Conveyor)
		  </Description>
		  <CubeSize>Small</CubeSize>
		  <GuiVisible>false</GuiVisible>
		  <BlockTopology>TriangleMesh</BlockTopology>
		  <Size x="1" y="1" z="5"/>
		  <ModelOffset x="0" y="0" z="0"/>
		  <Model>Models\Models\Cubes\small\PylonUSc.mwm</Model>
		  <Components>
			  <Component Subtype="InteriorPlate" Count="10"/>
		  </Components>
		  <CriticalComponent Subtype="InteriorPlate" Index="0"/>
		  <MountPoints>
			  <MountPoint Side="Top" StartX="0.00" StartY="0.00" EndX="1.00" EndY="5.00"/>
			  <MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="1.00" EndY="5.00"/>
		  </MountPoints>
		  <BuildProgressModels>
			  <Model BuildPercentUpperBound="1.00" File="Models\Models\Cubes\Small\PylonUSc.mwm" />
		  </BuildProgressModels>
		  <BlockPairName>PylonUSc</BlockPairName>
		  <MirroringY>Z</MirroringY>
		  <MirroringZ>Y</MirroringZ>
		  <EdgeType>Light</EdgeType>
		  <BuildTimeSeconds>12</BuildTimeSeconds>
		  <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
		  <DamagedSound>ParticleHeavyMech</DamagedSound>
		  <EmissiveColorPreset>Default</EmissiveColorPreset>
		  <DestroyEffect>BlockDestroyed_Small</DestroyEffect>
		  <DestroySound>PoofExplosionCat1</DestroySound>
		  <PCU>10</PCU>
		  <IsAirTight>true</IsAirTight>
	  </Definition>
	  
