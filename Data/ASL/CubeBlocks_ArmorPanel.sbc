			  <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="1" ExclusionMask="3" PropertiesMask="3" />
			  <!-- using property mask to make panel airtight -->
		  </MountPoints>
		  <BuildProgressModels>
			  <Model BuildPercentUpperBound="1.00" File="Models\Models\Cubes\Large\LightArmorSlopedSidePanelCentered.mwm" />
		  </BuildProgressModels>
		  <BlockPairName>LightArmorSlopedSidePanelCentered</BlockPairName>
		  <MirroringX>ZMinusHalfX</MirroringX>
		  <MirroringY>XHalfX</MirroringY>
		  <MirroringZ>HalfX</MirroringZ>
		  <EdgeType>Light</EdgeType>
