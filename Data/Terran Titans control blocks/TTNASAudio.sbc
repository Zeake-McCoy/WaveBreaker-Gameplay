<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>

    <!-- ═══════════════════════════════════════════════════
         AUDIO CONTROLLER
         One per ship. Holds all event-to-sound config.
         ═══════════════════════════════════════════════════ -->

    <!-- Large Grid -->
    <Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
      <Id>
        <TypeId>ConveyorSorter</TypeId>
        <SubtypeId>TT_AudioController</SubtypeId>
      </Id>
      <DisplayName>TT Audio Controller WIP</DisplayName>
      <Description>Monitors CIC events and triggers audio alerts on connected TT Audio Speaker blocks. Configure which sound plays for each combat event.</Description>
      <Icon>Textures\GUI\Icons\TTGridCoreTempLG.dds</Icon>
      <BlockTopology>TriangleMesh</BlockTopology>
      <CubeSize>Large</CubeSize>
      <Size x="1" y="1" z="1" />
      <Model>Models\Cubes\large\TTGridCoreTempLG.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate"   Count="15" />
        <Component Subtype="Computer"     Count="10" />
        <Component Subtype="Construction" Count="4"  />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.50" File="Models\Cubes\large\TTGridCoreTempLG_BS1.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\large\TTGridCoreTempLG_BS2.mwm" />
      </BuildProgressModels>
      <BuildTimeSeconds>10</BuildTimeSeconds>
      <MaxIntegrity>2000</MaxIntegrity>
      <MountPoints>
        <MountPoint Side="Top"    StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Left"   StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Right"  StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Front"  StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Back"   StartX="0" StartY="0" EndX="1" EndY="1" />
      </MountPoints>
      <BlockPairName>TT_AudioController</BlockPairName>
      <Public>true</Public>
      <GuiVisible>true</GuiVisible>
      <PCU>5</PCU>
      <IsAirTight>true</IsAirTight>
    </Definition>

    <!-- Small Grid -->
    <Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
      <Id>
        <TypeId>ConveyorSorter</TypeId>
        <SubtypeId>TT_AudioController_SG</SubtypeId>
      </Id>
      <DisplayName>TT Audio Controller WIP</DisplayName>
      <Description>Monitors CIC events and triggers audio alerts on connected TT Audio Speaker blocks. Configure which sound plays for each combat event.</Description>
      <Icon>Textures\GUI\Icons\TTGridCoreTempLG.dds</Icon>
      <BlockTopology>TriangleMesh</BlockTopology>
      <CubeSize>Small</CubeSize>
      <Size x="1" y="1" z="1" />
      <Model>Models\Cubes\small\TTGridCoreTempsg.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate"   Count="5" />
        <Component Subtype="Computer"     Count="5" />
        <Component Subtype="Construction" Count="2" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.50" File="Models\Cubes\small\TTGridCoreTempsg_BS1.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\small\TTGridCoreTempsg_BS2.mwm" />
      </BuildProgressModels>
      <BuildTimeSeconds>10</BuildTimeSeconds>
      <MaxIntegrity>500</MaxIntegrity>
      <MountPoints>
        <MountPoint Side="Top"    StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Left"   StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Right"  StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Front"  StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Back"   StartX="0" StartY="0" EndX="1" EndY="1" />
      </MountPoints>
      <BlockPairName>TT_AudioController</BlockPairName>
      <Public>true</Public>
      <GuiVisible>true</GuiVisible>
      <PCU>5</PCU>
      <IsAirTight>true</IsAirTight>
    </Definition>

    <!-- ═══════════════════════════════════════════════════
         AUDIO SPEAKER
         Zero-config. Place anywhere on ship for positional audio.
         Uses vanilla Sound Block model as placeholder.
         ═══════════════════════════════════════════════════ -->

    <!-- Large Grid -->
    <Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
      <Id>
        <TypeId>ConveyorSorter</TypeId>
        <SubtypeId>TT_AudioSpeaker</SubtypeId>
      </Id>
      <DisplayName>TT Audio Speaker</DisplayName>
      <Description>Plays audio alerts triggered by the TT Audio Controller on this grid. Place multiple speakers for distributed ship-wide sound coverage.</Description>
      <Icon>Textures\GUI\Icons\Cubes\SoundBlock.dds</Icon>
      <BlockTopology>TriangleMesh</BlockTopology>
      <CubeSize>Large</CubeSize>
      <Size x="1" y="1" z="1" />
      <Model>Models\Cubes\Large\SoundBlock.mwm</Model>
      <Components>
        <Component Subtype="InteriorPlate" Count="4"  />
        <Component Subtype="Construction"  Count="6"  />
        <Component Subtype="Computer"      Count="3"  />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.50" File="Models\Cubes\Large\SoundBlockConstruction_1.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\SoundBlockConstruction_2.mwm" />
      </BuildProgressModels>
      <BuildTimeSeconds>8</BuildTimeSeconds>
      <MaxIntegrity>1500</MaxIntegrity>
      <MountPoints>
        <MountPoint Side="Back" StartX="0.4" StartY="0.4" EndX="0.6" EndY="0.6" />
      </MountPoints>
      <BlockPairName>TT_AudioSpeaker</BlockPairName>
      <Public>true</Public>
      <GuiVisible>true</GuiVisible>
      <PCU>5</PCU>
      <IsAirTight>false</IsAirTight>
    </Definition>

    <!-- Small Grid -->
    <Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
      <Id>
        <TypeId>ConveyorSorter</TypeId>
        <SubtypeId>TT_AudioSpeaker_SG</SubtypeId>
      </Id>
      <DisplayName>TT Audio Speaker</DisplayName>
      <Description>Plays audio alerts triggered by the TT Audio Controller on this grid. Place multiple speakers for distributed ship-wide sound coverage.</Description>
      <Icon>Textures\GUI\Icons\Cubes\SoundBlock.dds</Icon>
      <BlockTopology>TriangleMesh</BlockTopology>
      <CubeSize>Small</CubeSize>
      <Size x="1" y="1" z="1" />
      <Model>Models\Cubes\Small\SoundBlock.mwm</Model>
      <Components>
        <Component Subtype="InteriorPlate" Count="1"  />
        <Component Subtype="Construction"  Count="6"  />
        <Component Subtype="Computer"      Count="3"  />
        <Component Subtype="InteriorPlate" Count="3"  />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <BuildProgressModels>
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Small\SoundBlockConstruction_1.mwm" />
      </BuildProgressModels>
      <BuildTimeSeconds>6</BuildTimeSeconds>
      <MaxIntegrity>400</MaxIntegrity>
      <MountPoints>
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="1" />
      </MountPoints>
      <BlockPairName>TT_AudioSpeaker</BlockPairName>
      <Public>true</Public>
      <GuiVisible>true</GuiVisible>
      <PCU>5</PCU>
      <IsAirTight>false</IsAirTight>
    </Definition>

  </CubeBlocks>
</Definitions>
