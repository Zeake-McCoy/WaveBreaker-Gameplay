      </RagdollBonesMappings>
      
      
    <DeadBodyShape>
      <BoxShapeScale x="2" y="0.5" z="2"/>
      <RelativeCenterOfMass x="0" y="0.5" z="0"/>
      <RelativeShapeTranslation x="0" y="-0.25" z="0"/>
      <Friction>200</Friction>
    </DeadBodyShape>
		
		<RotationToSupport>OneAxis</RotationToSupport>

    </Character>

   
	
  </Characters>
</Definitions>