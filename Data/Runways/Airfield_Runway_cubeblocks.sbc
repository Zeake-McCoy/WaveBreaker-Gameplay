<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
<!--Begin BlockCategories -->
  <CategoryClasses>
    <Category xsi:type="MyObjectBuilder_GuiBlockCategoryDefinition">
      <Id>
        <TypeId>GuiBlockCategoryDefinition</TypeId>
        <SubtypeId/>
      </Id>
      <DisplayName>DisplayName_Category_LargeBlocks</DisplayName>
      <Name>LargeBlocks</Name>
      <ItemIds>
        <string>NarrowRunwayStart</string>
        <string>RunwayStart</string>
        <string>NarrowRunwayMiddle</string>
        <string>RunwayMiddle</string>
        <string>RunwayStartAngled</string>
        <string>RunwayMiddleAngled</string>
        <string>RunwayStartWide</string>
        <string>RunwayMiddleWide</string>
        <string>RunwayStartAngledWide</string>
        <string>RunwayMiddleAngledWide</string>
        <string>Helipad</string>
      </ItemIds>
    </Category>
    <Category xsi:type="MyObjectBuilder_GuiBlockCategoryDefinition">
      <Id>
        <TypeId>GuiBlockCategoryDefinition</TypeId>
        <SubtypeId/>
      </Id>
      <DisplayName>Runways</DisplayName>
      <Name>Runways</Name>
      <ItemIds>
        <string>NarrowRunwayStart</string>
        <string>RunwayStart</string>
        <string>NarrowRunwayMiddle</string>
        <string>RunwayStartAngled</string>
        <string>RunwayMiddleAngled</string>
        <string>RunwayStartWide</string>
        <string>RunwayMiddleWide</string>
        <string>RunwayStartAngledWide</string>
        <string>RunwayMiddleAngledWide</string>
        <string>Helipad</string>
      </ItemIds>
    </Category>
  </CategoryClasses>
<!--End BlockCategories -->
  <Components>
   <Component>
      <Id>
        <TypeId>Component</TypeId>
        <SubtypeId>CementMixItem</SubtypeId>
      </Id>
      <DisplayName>Cement Mix</DisplayName>
      <Icon>Textures\Icons\CementMix.dds</Icon>
      <Size>
        <X>0.5</X>
        <Y>0.5</Y>
        <Z>0.01</Z>
      </Size>
      <Mass>20</Mass>
      <Volume>3</Volume>
      <Model>Models\Ingots\stone_ingot.mwm</Model>
      <PhysicalMaterial>Stone</PhysicalMaterial>
      <MaxIntegrity>300</MaxIntegrity>
      <DropProbability>0.9</DropProbability>
      <Health>2500</Health>
    </Component>
   </Components>

<!--Begin Blueprint Stuff-->
    <Blueprints>
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>CementMixItem</SubtypeId>
      </Id>
      <DisplayName>Cement Mix</DisplayName>
      <Icon>Textures\Icons\CementMix.dds</Icon>
      <Prerequisites>
        <Item Amount="10" TypeId="Ingot" SubtypeId="Stone" />
        <Item Amount="25" TypeId="Ingot" SubtypeId="Silicon" />
      </Prerequisites>
      <Result Amount="35" TypeId="Component" SubtypeId="CementMixItem" />
      <BaseProductionTimeInSeconds>1</BaseProductionTimeInSeconds>
    </Blueprint>
   </Blueprints>
  <BlueprintClasses>
  </BlueprintClasses>
  <BlueprintClassEntries>
  
   <!-- Large Block -->
    <Entry Class="LargeBlocks" BlueprintSubtypeId="RunwayStart" />
    <Entry Class="LargeBlocks" BlueprintSubtypeId="RunwayMiddle" />
    <Entry Class="LargeBlocks" BlueprintSubtypeId="RunwayStartAngled" />
    <Entry Class="LargeBlocks" BlueprintSubtypeId="RunwayMiddleAngled" />
    <Entry Class="LargeBlocks" BlueprintSubtypeId="RunwayStartWide" />
    <Entry Class="LargeBlocks" BlueprintSubtypeId="RunwayMiddleWide" />
    <Entry Class="LargeBlocks" BlueprintSubtypeId="RunwayStartAngledWide" />
    <Entry Class="LargeBlocks" BlueprintSubtypeId="RunwayMiddleAngledWide" />
    <Entry Class="LargeBlocks" BlueprintSubtypeId="Helipad" />
	
  <!-- Components -->
	<Entry Class="Components" BlueprintSubtypeId="CementMixItem" />
	
  </BlueprintClassEntries>
<!--End BlueprintClasses-->

  
<!--Begin Cubeblocks definitions-->
  <CubeBlocks>
    <Definition xsi:type="MyObjectBuilder_TextPanelDefinition">
      <Id>
        <TypeId>TextPanel</TypeId>
        <SubtypeId>RunwayStart</SubtypeId>
      </Id>
      <DisplayName>Runway Start End</DisplayName>
      <Icon>Textures\Icons\RunwayEnd.dds</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="11" y="1" z="20" />
      <ModelOffset x="0" y="0" z="0" />
      <Center x="10" y="0" z="19" />
      <Model>Models\Cubes\RunwayStart.mwm</Model>
      <Components>
        <Component Subtype="Girder" Count="1000" />
        <Component Subtype="CementMixItem" Count="1100" />
        
      </Components>
      <CriticalComponent Subtype="CementMixItem" Index="0" />
      <MountPoints>
		<MountPoint Side="Front" StartX="0.00" StartY="0.00" EndX="11" EndY="0.99" Default="true" />
		<MountPoint Side="Back" StartX="0.00" StartY="0.00" EndX="11" EndY="0.99" />
		<MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="20" EndY="0.99" />
		<MountPoint Side="Right" StartX="0.00" StartY="0.00" EndX="20" EndY="0.99" />
		<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="11" EndY="20" />
		<MountPoint Side="Top" StartX="0.00" StartY="0.00" EndX="11" EndY="20" />
      </MountPoints>
      <EdgeType>Light</EdgeType>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\RunwayStart_Constr1.mwm" />
      </BuildProgressModels>
      <BuildTimeSeconds>45</BuildTimeSeconds>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <MirroringZ>Y</MirroringZ>
      <MirroringY>Z</MirroringY>	  
      <BlockPairName>RunwayStartSection</BlockPairName>
      <RequiredPowerInput>0.00006</RequiredPowerInput>
      <TextureResolution>512</TextureResolution>
      <TextureAspectRadio>1</TextureAspectRadio>
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroyEffectOffset>
        <X>0</X>
        <Y>-1.1</Y>
        <Z>1.1</Z>
      </DestroyEffectOffset>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>5</PCU>
	   <BlockVariants>
        <BlockVariant>
          <TypeId>TextPanel</TypeId>
          <SubtypeId>RunwayStartAngled</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>RunwayMiddle</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>NarrowRunwayMiddle</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>TextPanel</TypeId>
          <SubtypeId>NarrowRunwayStart</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>RunwayMiddleAngled</SubtypeId>
        </BlockVariant>
	   </BlockVariants>
	   <UsesDeformation>false</UsesDeformation>
       <DeformationRatio>0.0</DeformationRatio>
    </Definition>
	
	<!-- Narrow sections -->
