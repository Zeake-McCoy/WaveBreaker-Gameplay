    <Factions>
        <Faction Tag="WB" Founder="WaveBreaker">
            <Id>
                <TypeId>MyObjectBuilder_FactionDefinition</TypeId>
                <SubtypeId>WB_Faction</SubtypeId>
            </Id>
            <DisplayName>WaveBreaker</DisplayName>
            <Description>Official WaveBreaker Admin Faction</Description>
			<DefaultRelation>Neutral</DefaultRelation>
            <AcceptHumans>false</AcceptHumans>
            <AutoAcceptMember>false</AutoAcceptMember>
            <IsDefault>true</IsDefault>
            <StartingBalance>90000000000</StartingBalance>
            <DiscoveredByDefault>true</DiscoveredByDefault>
            <FactionIcon>Textures\Factions\WB.png</FactionIcon>
        </Faction>
    </Factions>


