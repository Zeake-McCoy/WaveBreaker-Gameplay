          <Block Type="MyObjectBuilder_ExhaustBlock" Subtype="ShipExhaustProvinces2x2L" />
          <Block Type="MyObjectBuilder_ExhaustBlock" Subtype="ShipExhaustProvinces2x2R" />
          <Block Type="MyObjectBuilder_ExhaustBlock" Subtype="ShipExhaustProvinces2x2C" />
          <Block Type="MyObjectBuilder_ExhaustBlock" Subtype="ShipExhaustProvinces1x1C" />
          <Block Type="MyObjectBuilder_ExhaustBlock" Subtype="TTBURKESTACKFront" />
          <Block Type="MyObjectBuilder_ExhaustBlock" Subtype="TTBURKESTACKRear" />
