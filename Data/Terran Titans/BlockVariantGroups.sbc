          <Block Type="MyObjectBuilder_CubeBlock" Subtype="TTDARING_ANGLED_Right" />
          <Block Type="MyObjectBuilder_CubeBlock" Subtype="TTDARING_ANGLED_left" />
          <Block Type="MyObjectBuilder_CubeBlock" Subtype="TTDARING_ANGLED" />
          <Block Type="MyObjectBuilder_CubeBlock" Subtype="TTDARING_Ceiling" />
