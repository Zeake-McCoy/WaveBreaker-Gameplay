<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition>
			<Id>
				<TypeId>CubeBlock</TypeId>
				<SubtypeId>TTBridgeWindow2x1x1Base</SubtypeId>
			</Id>
			<DisplayName>Bridge Window 2x1x1 Base</DisplayName>
			<Description>Lightly more armored than regular windows.</Description>
			<Icon>Textures\GUI\Icons\TTBridgeWindow2x1x1Base.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\large\TTBridgeWindow2x1x1Base.mwm</Model>
			<Components>
					<Component Subtype="SteelPlate" Count="25" />
					<Component Subtype="Construction" Count="5" />
					<Component Subtype="BulletproofGlass" Count="10" />
					<Component Subtype="Construction" Count="5" />
			</Components>
			<CriticalComponent Subtype="BulletproofGlass" Index="0" />
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.50" File="Models\Cubes\large\TTBridgeWindow2x1x1Base_BS1.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Cubes\large\TTBridgeWindow2x1x1Base_BS2.mwm"/>
			</BuildProgressModels>
			<BlockPairName>TTBridgeWindow2x1x1Base</BlockPairName>
			<MirroringX>Y</MirroringX>
						<IsAirTight>true</IsAirTight>
		</Definition>


