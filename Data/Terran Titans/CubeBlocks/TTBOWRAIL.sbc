<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition>
			<Id>
				<TypeId>CubeBlock</TypeId>
				<SubtypeId>TTBOWRAIL</SubtypeId>
			</Id>
			<DisplayName>Bow Rail</DisplayName>
			<Description>Bow Rail for pointy bow blocks</Description>
			<Icon>Textures\GUI\Icons\TTBOWRAIL.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<GuiVisible>false</GuiVisible>
			<Size x="1" y="1" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\large\TTBOWRAIL.mwm</Model>
            <Components>
                <Component Subtype="SteelPlate" Count="20" />
                <Component Subtype="Construction" Count="14" />
                <Component Subtype="LargeTube" Count="8" />
            </Components>
            <CriticalComponent Subtype="Construction" Index="0" />
			<MountPoints>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
			</MountPoints>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.50" File="Models\Cubes\large\TTBOWRAIL_BS1.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Cubes\large\TTBOWRAIL_BS2.mwm"/>
			</BuildProgressModels>
			<MirroringX>Y</MirroringX>
			<MirroringY>X</MirroringY>
			<BuildTimeSeconds>8</BuildTimeSeconds>
			<BlockPairName>TTBOWRAIL</BlockPairName>
			<DLC>DecorativeBlocks2</DLC>
			<IsAirTight>false</IsAirTight>
		</Definition>
	</CubeBlocks>
</Definitions>
