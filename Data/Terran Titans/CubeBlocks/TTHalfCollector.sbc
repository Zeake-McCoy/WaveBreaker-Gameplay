<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_PoweredCargoContainerDefinition">
				<Id>
						<TypeId>Collector</TypeId>
				<SubtypeId>TTHalfCollector</SubtypeId>
			</Id>
			<DisplayName>Half Height Collector</DisplayName>
			<Description>Half height collector, to collect ice from the water.</Description>
			<Icon>Textures\GUI\Icons\TTHalfCollector.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\large\TTHalfCollector.mwm</Model>
			<Components>
					<Component Subtype="SteelPlate" Count="15" />
					<Component Subtype="Construction" Count="25" />
					<Component Subtype="SmallTube" Count="6" />
					<Component Subtype="Motor" Count="4" />
					<Component Subtype="Display" Count="4" />
					<Component Subtype="Computer" Count="5" />
					<Component Subtype="SteelPlate" Count="10" />
			</Components>
			<CriticalComponent Subtype="Computer" Index="0" />
			<BuildProgressModels>
				<Model BuildPercentUpperBound="1.00" File="Models\Cubes\large\TTHalfCollector_BS1.mwm"/>
			</BuildProgressModels>
			<MountPoints>
				<MountPoint Side="Front" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
				<MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="0.49" EndY="1.00"/>
				<MountPoint Side="Right" StartX="0.51" StartY="0.00" EndX="1.00" EndY="1.00"/>
				<MountPoint Side="Top" StartX="0.00" StartY="0.51" EndX="1.00" EndY="1.00"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="1.00" EndY="0.49"/>
			</MountPoints>
			<BlockPairName>TTHalfCollector</BlockPairName>
			<MirroringZ>Y</MirroringZ>
			<EdgeType>Light</EdgeType>
			<BuildTimeSeconds>25</BuildTimeSeconds>
			<ResourceSinkGroup>Conveyors</ResourceSinkGroup>
			<RequiredPowerInput>0.002</RequiredPowerInput>
			<InventorySize>
					<X>1.25</X>
					<Y>1.25</Y>
					<Z>0.50</Z>
			</InventorySize>
			<DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
			<DamagedSound>ParticleHeavyMech</DamagedSound>
			<ActionSound>BlockCollect</ActionSound>
			<DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>25</PCU>
			<IsAirTight>true</IsAirTight>
		</Definition>
	</CubeBlocks>
</Definitions>
