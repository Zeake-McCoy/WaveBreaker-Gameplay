<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ThrustDefinition">
        <Id>
          <TypeId>Thrust</TypeId>
				<SubtypeId>TT1x1slope2x1baseprop</SubtypeId>
			</Id>
			<DisplayName>Slope 2x1x1 Base Maneuvering Propeller (200MT)</DisplayName>
			<Description>A ship propulsion system designed for maneuvering and stability.</Description>
			<Icon>Textures\GUI\Icons\TT1x1slope2x1baseprop.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\large\TT1x1slope2x1baseprop.mwm</Model>
			<ThrusterType>Atmospheric</ThrusterType>
			<SilenceableByShipSoundSystem>true</SilenceableByShipSoundSystem>
			<Components>
			<Component Subtype="SteelPlate" Count="15" />
			<Component Subtype="Construction" Count="30" />
			<Component Subtype="LargeTube" Count="8" />
			<Component Subtype="MetalGrid" Count="10" />
			<Component Subtype="Motor" Count="20" />
			<Component Subtype="Construction" Count="10" />
			<Component Subtype="SteelPlate" Count="20" />
		</Components>
		<CriticalComponent Subtype="Motor" Index="0" />
			<MountPoints>
				<MountPoint Side="Back" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
				<MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
				<MountPoint Side="Right" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
				<MountPoint Side="Top" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.49" EndX="1.00" EndY="0.99"/>
			</MountPoints>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.50" File="Models\Cubes\large\TThalfblockprop_BS1.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Cubes\large\TThalfblockprop_BS2.mwm"/>
			</BuildProgressModels>
			<BlockPairName>TT1x1slope2x1baseprop</BlockPairName>
			<MirroringZ>Y</MirroringZ>
			<MirroringY>Z</MirroringY>
			<EdgeType>Light</EdgeType>
			<BuildTimeSeconds>10</BuildTimeSeconds>
			<ResourceSinkGroup>Thrust</ResourceSinkGroup>
			<ForceMagnitude>1961330</ForceMagnitude>
			<MaxPowerConsumption>1.5</MaxPowerConsumption>
			<MinPowerConsumption>0.000000001</MinPowerConsumption>
			<SlowdownFactor>1</SlowdownFactor>
			<MinPlanetaryInfluence>0.3</MinPlanetaryInfluence>
		      <MaxPlanetaryInfluence>1</MaxPlanetaryInfluence>
		      <EffectivenessAtMinInfluence>0</EffectivenessAtMinInfluence>
		      <EffectivenessAtMaxInfluence>1</EffectivenessAtMaxInfluence>
		      <NeedsAtmosphereForInfluence>true</NeedsAtmosphereForInfluence>

		        <PropellerUsesPropellerSystem>true</PropellerUsesPropellerSystem>
		      <PropellerSubpartEntityName>propellor</PropellerSubpartEntityName>
		      <PropellerRoundsPerSecondOnFullSpeed>5</PropellerRoundsPerSecondOnFullSpeed>
		      <PropellerRoundsPerSecondOnIdleSpeed>0</PropellerRoundsPerSecondOnIdleSpeed>
		      <PropellerAccelerationTime>1</PropellerAccelerationTime>
		      <PropellerDecelerationTime>3</PropellerDecelerationTime>
		      <PropellerMaxVisibleDistance>500</PropellerMaxVisibleDistance>
		      <PrimarySound>LrgShipSmJetAtmo</PrimarySound>
		      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
		      <DamagedSound>ParticleWeapExpl</DamagedSound>
		      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
		      <DestroySound>WepSmallWarheadExpl</DestroySound>
		      <PCU>15</PCU>
		        <IsAirTight>true</IsAirTight>
				            <TargetingGroups>
                <string>Propulsion</string>
            </TargetingGroups>
		</Definition>

