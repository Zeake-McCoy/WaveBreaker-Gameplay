<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
        <Definition xsi:type="MyObjectBuilder_LaserAntennaDefinition">
            <Id>
                <TypeId>LaserAntenna</TypeId>
				<SubtypeId>TTANWCS6</SubtypeId>
			</Id>
			<DisplayName>AN/WSC-6 SATCOM</DisplayName>
			<Description>Satelite Communications Array
            This is a non LOS laser antenna.
            </Description>
			<Icon>Textures\GUI\Icons\TTANWCS6Radar.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\large\TTANWCS6Radar.mwm</Model>
            <Components>
                <Component Subtype="SteelPlate" Count="100" />
                <Component Subtype="Construction" Count="40" />
                <Component Subtype="Motor" Count="16" />
                <Component Subtype="Detector" Count="30" />
                <Component Subtype="RadioCommunication" Count="20" />
                <Component Subtype="Superconductor" Count="100" />
                <Component Subtype="Computer" Count="100" />
                <Component Subtype="SteelPlate" Count="100" />
            </Components>
            <CriticalComponent Subtype="Computer" Index="0" />
			<MountPoints>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
			</MountPoints>
			<MirroringY>Z</MirroringY>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.50" File="Models\Cubes\large\TTANWCS6Radar_BS1.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Cubes\large\TTANWCS6Radar_BS2.mwm"/>
			</BuildProgressModels>
			<BuildTimeSeconds>40</BuildTimeSeconds>
			<BlockPairName>TTANWCS6</BlockPairName>
            <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
            <DamagedSound>ParticleElectrical</DamagedSound>
            <ResourceSinkGroup>Utility</ResourceSinkGroup>
            <PowerInputIdle>0.01</PowerInputIdle>
            <PowerInputTurning>1</PowerInputTurning>
            <PowerInputLasing>200</PowerInputLasing>
            <MinElevationDegrees>-180</MinElevationDegrees>
            <MaxElevationDegrees>180</MaxElevationDegrees>
            <MinAzimuthDegrees>-180</MinAzimuthDegrees>
            <MaxAzimuthDegrees>180</MaxAzimuthDegrees>
            <RotationRate>0.01</RotationRate>
            <MaxRange>-1</MaxRange>
            <RequireLineOfSight>false</RequireLineOfSight>
            <EmissiveColorPreset>Extended</EmissiveColorPreset>
            <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
            <DestroySound>WepSmallWarheadExpl</DestroySound>
            <PCU>100</PCU>
		</Definition>
	</CubeBlocks>
</Definitions>
