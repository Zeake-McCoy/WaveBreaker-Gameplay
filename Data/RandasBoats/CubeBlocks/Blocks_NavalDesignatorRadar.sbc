<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
    

    <Definition xsi:type="MyObjectBuilder_LargeTurretBaseDefinition">
      <Id>
        <TypeId>LargeMissileTurret</TypeId>
        <SubtypeId>NavalRadarDesignator1</SubtypeId>
      </Id>
      <DisplayName>Naval Radar Designator (2km Range)</DisplayName>
      <Description>A "turret" with a VERY narrow field of vision. get it on a rotor to rotate and track targets for turret based radar. Uses Radar Designator Ammo</Description>
      <Icon>Textures\Icons\NavalRadarDesignator1.png</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="3" y="1" z="1"/>
      <ModelOffset x="0" y="0" z="0"/>
      <Model>Models\NavalRadarDesignator1.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="10" />
        <Component Subtype="BulletproofGlass" Count="1" />
        <Component Subtype="Computer" Count="50" />
        <Component Subtype="Motor" Count="5" />
        <Component Subtype="Construction" Count="20" />
        <Component Subtype="SteelPlate" Count="15" />
      </Components>

      <BuildProgressModels>
        <Model BuildPercentUpperBound="1.00" File="Models\NavalRadarDesignator1.mwm"/>
      </BuildProgressModels>


      <CriticalComponent Subtype="Motor" Index="0" />
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <BuildTimeSeconds>10</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion>
      <WeaponDefinitionId Subtype="RandaDesignatorFakeWep" />
      <InventoryMaxVolume>0.5</InventoryMaxVolume>
      <DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
      <DamagedSound>ParticleWeapExpl</DamagedSound>
      <ResourceSinkGroup>Defense</ResourceSinkGroup>
      <MinElevationDegrees>-5</MinElevationDegrees>
      <MaxElevationDegrees>5</MaxElevationDegrees>
      <MinAzimuthDegrees>-5</MinAzimuthDegrees>
      <MaxAzimuthDegrees>5</MaxAzimuthDegrees>
      <IdleRotation>false</IdleRotation>
      <MaxRangeMeters>2000</MaxRangeMeters>
      <RotationSpeed>1</RotationSpeed>
      <ElevationSpeed>1 </ElevationSpeed>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <MinFov>0.65</MinFov>
      <MaxFov>0.655</MaxFov>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>20</PCU>
    </Definition>


  </CubeBlocks>
</Definitions>
