<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>




		<Definition>
			<Id>
				<TypeId>CubeBlock</TypeId>
				<SubtypeId>ShipWindow1x2Base</SubtypeId>
			</Id>
			<DisplayName>Ship Window 1x2 Base</DisplayName>
			<Description>A window for modern style ship bridges</Description>
			<Icon>Textures\Icons\ShipWindow1x2Base.png</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\ShipWindow1x2Base.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="15"/>
				<Component Subtype="BulletproofGlass" Count="15"/>
			</Components>
			<CriticalComponent Subtype="SteelPlate" Index="0"/>
			<BlockPairName>ShipWindow1x2Base</BlockPairName>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
			<BlockVariants>
        
      				<BlockVariant>
      					<TypeId>CubeBlock</TypeId>
        				<SubtypeId>ShipWindow1x2BaseCorner</SubtypeId>
      				</BlockVariant>     
				<BlockVariant>
      					<TypeId>CubeBlock</TypeId>
        				<SubtypeId>ShipWindow1x2BaseCornerInverted</SubtypeId>
      				</BlockVariant>
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>ShipWindow1x2SideRight</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>ShipWindow1x2SideLeft</SubtypeId>
        </BlockVariant>

      </BlockVariants>
		</Definition>

		<Definition>
			<Id>
				<TypeId>CubeBlock</TypeId>
