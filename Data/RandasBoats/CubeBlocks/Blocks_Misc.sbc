<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>

    <Definition>
      <Id>
        <TypeId>CubeBlock</TypeId>
        <SubtypeId>WingFillRanda</SubtypeId>
      </Id>
      <DisplayName>Non-Deforming Fill Block</DisplayName>
      <Description>A large grid block that is similar to a standard light armour block, except it doesnt deform making it good for things such as carrier elevators.</Description>
      <Icon>Textures\Icons\WingFillRanda.png</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1"/>
      <ModelOffset x="0" y="0" z="0"/>
      <Model>Models\WingFillRanda.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="25"/>
      </Components>
      <CriticalComponent Subtype="SteelPlate" Index="0"/>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="1.00" File="Models\WingFillRanda_BS1.mwm"/>
      </BuildProgressModels>
      <BlockPairName>WingFillRanda</BlockPairName>
    </Definition>

