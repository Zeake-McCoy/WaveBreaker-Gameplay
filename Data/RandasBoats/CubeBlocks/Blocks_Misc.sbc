    <!-- Markings-->


    <Definition>
      <Id>
        <TypeId>CubeBlock</TypeId>
        <SubtypeId>CarrierMarkingFull</SubtypeId>
      </Id>
      <DisplayName>Carrier Marking Full</DisplayName>
      <Description>Collisionless block for carrier markings that wont eat wheels</Description>
      <Icon>Textures\Icons\CarrierMarkingFull.png</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1"/>
      <ModelOffset x="0" y="0" z="0"/>
      <Model>Models\CarrierMarkingFull.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="1"/>
      </Components>
      <CriticalComponent Subtype="SteelPlate" Index="0"/>
      <IsStandAlone>false</IsStandAlone>
	  <IsAirtight>false</IsAirtight>
      <HasPhysics>false</HasPhysics>
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="0.48" EndY="1.00"/>
        <MountPoint Side="Bottom" StartX="0.52" StartY="0.00" EndX="1.00" EndY="1.00"/>
      </MountPoints>
      <BlockPairName>CarrierMarkingFull</BlockPairName>
      <MirroringY>Z</MirroringY>
      <BlockVariants>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>CarrierMarkingHalf</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>CarrierMarkingHalfCentre</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>CarrierMarkingQuarter</SubtypeId>
        </BlockVariant>

      </BlockVariants>
    </Definition>

