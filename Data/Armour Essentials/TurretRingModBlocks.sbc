				</BlockVariant>
				<BlockVariant>
					<TypeId>MotorAdvancedRotor</TypeId>
					<SubtypeId>AdvTurretRingRotor3x3</SubtypeId>
				</BlockVariant>
				<BlockVariant>
					<TypeId>CubeBlock</TypeId>
