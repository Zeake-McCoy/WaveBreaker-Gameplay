		<Definition xsi:type="MyObjectBuilder_MotorStatorDefinition"> <!--Stator3x3-->
			<Id>
				<TypeId>MotorStator</TypeId>
				<SubtypeId>TurretRingStator3x3</SubtypeId>
			</Id>
			<DisplayName>TurretRing Rotor 3x3</DisplayName>
			<Description>A durable azimuth rotor that can survive more than a strong breeze</Description>
			<Icon>Textures\GUI\Icons\Cubes\TurretRingStator3x3.dds</Icon>
			<CubeSize>Small</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\small\TurretRingStator3x3.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="30"/>
				<Component Subtype="MetalGrid" Count="10" />
				<Component Subtype="LargeTube" Count="4" />
				<Component Subtype="Motor" Count="8" />
				<Component Subtype="SteelPlate" Count="12"/>
			</Components>
			<CriticalComponent Subtype="Motor" Index="0"/>
			<!--Fuckery Begins-->
			<BlockPairName>TurretRingStator3x3</BlockPairName>
			<EdgeType>Light</EdgeType>
			<BuildTimeSeconds>30</BuildTimeSeconds>
			<ResourceSinkGroup>Utility</ResourceSinkGroup>
			<RequiredPowerInput>0.002</RequiredPowerInput>
			<MaxForceMagnitude>2E9</MaxForceMagnitude>
			<DangerousTorqueThreshold>3.36E+07</DangerousTorqueThreshold>
			<PropulsionForce>15000</PropulsionForce>
			<RotorPart>TurretRingRotor3x3</RotorPart>
			<RotorDisplacementMin>-1.0</RotorDisplacementMin>
			<RotorDisplacementMax>1.0</RotorDisplacementMax>
			<RotorDisplacementMinSmall>-1.0</RotorDisplacementMinSmall>
			<RotorDisplacementMaxSmall>1.0</RotorDisplacementMaxSmall>
			<RotorDisplacementInModel>0.0</RotorDisplacementInModel>
			<SafetyDetach>5</SafetyDetach>
			<SafetyDetachMax>5</SafetyDetachMax>
			<RotorType>Rotor</RotorType>
			<PCU>100</PCU>
			<IsAirTight>false</IsAirTight>
			<BlockVariants>
				<BlockVariant>
					<TypeId>MotorStator</TypeId>
					<SubtypeId>TurretRingStator3x3_OFFSET</SubtypeId>
				</BlockVariant>
				<BlockVariant>
					<TypeId>MotorStator</TypeId>
					<SubtypeId>TurretRingStator3x3_CENTERED</SubtypeId>
				</BlockVariant>
				<BlockVariant>
					<TypeId>MotorStator</TypeId>
					<SubtypeId>TurretRingStator3x3Floored</SubtypeId>
				</BlockVariant>
				<BlockVariant>
					<TypeId>MotorStator</TypeId>
					<SubtypeId>TurretRingStator3x3Floored_OFFSET</SubtypeId>
				</BlockVariant>
				<BlockVariant>
					<TypeId>MotorStator</TypeId>
					<SubtypeId>TurretRingStator3x3Floored_CENTERED</SubtypeId>
				</BlockVariant>
				<BlockVariant>
					<TypeId>MotorAdvancedStator</TypeId>
					<SubtypeId>AdvTurretRingStator3x3Floored</SubtypeId>
				</BlockVariant>
				<BlockVariant>
					<TypeId>MotorAdvancedStator</TypeId>
					<SubtypeId>AdvTurretRingStator3x3Floored_OFFSET</SubtypeId>
				</BlockVariant>
				<BlockVariant>
					<TypeId>MotorAdvancedStator</TypeId>
					<SubtypeId>AdvTurretRingStator3x3Floored_CENTERED</SubtypeId>
				</BlockVariant>
				<BlockVariant>
					<TypeId>MotorRotor</TypeId>
