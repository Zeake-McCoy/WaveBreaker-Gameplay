	  <Definition>
		  <Id>
			  <TypeId>CubeBlock</TypeId>
			  <SubtypeId>ASL_ERA1</SubtypeId>
		  </Id>
		  <DisplayName>Explosive reactive armour 1</DisplayName>
		  <Icon>Models\Textures\GUI\Icons\Cubes\ASL_ERA1.dds</Icon>
		  <Description>
			ERA shaped armor, slightly stronger than ordinary Ceramic, but lighter
		  </Description>
		  <CubeSize>Small</CubeSize>
		  <BlockTopology>TriangleMesh</BlockTopology>
		  <Size x="1" y="1" z="1" />
		  <ModelOffset x="0" y="0" z="0" />
		  <Model>Models\Models\Cubes\small\ASL_ERA1.mwm</Model>
		  <Components>
			  <Component Subtype="ERA_Part" Count="4" />
		  </Components>
		  <CriticalComponent Subtype="ERA_Part" Index="0" />
		  <BuildProgressModels>
			  <Model BuildPercentUpperBound="1.00" File="Models\Models\Cubes\small\ASL_ERA1.mwm"/>
		  </BuildProgressModels>

		  <BlockPairName>ASL_ERA1</BlockPairName>
		  <EdgeType>Light</EdgeType>
		  <BuildTimeSeconds>2</BuildTimeSeconds>
		  <DisassembleRatio>2.5</DisassembleRatio>
		  <NavigationDefinition>Default</NavigationDefinition>
		  <MirroringY>Z</MirroringY>
		  <MirroringZ>Y</MirroringZ>
		  <PCU>1</PCU>
		  <PCUConsole>2</PCUConsole>
	  </Definition>
	  
