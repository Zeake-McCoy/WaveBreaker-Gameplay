  <CubeBlocks>


	  <Definition xsi:type="MyObjectBuilder_AdvancedDoorDefinition">
		  <Id>
			  <TypeId>AdvancedDoor</TypeId>
			  <SubtypeId>ASL_CustomRamp90_3</SubtypeId>
		  </Id>
		  <DisplayName>Custom Ramp 90 3x</DisplayName>
		  <Icon>Models\Textures\GUI\Icons\Cubes\ASL_lightArmor_Slope_3x1.dds</Icon>
		  <Description>
			  90 degree right angle Custom Ramp, Ramp 3block long

		  </Description>
		  <CubeSize>Small</CubeSize>
		  <BlockTopology>TriangleMesh</BlockTopology>
		  <Size x="1" y="1" z="1" />
		  <ModelOffset x="0" y="0" z="0" />
		  <Model>Models\Models\Cubes\Small\ASL_CustomRamp.mwm</Model>
		  <PlaceDecals>false</PlaceDecals>
		  <OpenSound>BlockDoorSmallOpen</OpenSound>
		  <CloseSound>BlockDoorSmallClose</CloseSound>
		  <Components>
			  <Component Subtype="InteriorPlate" Count="1" />
			  <Component Subtype="Motor" Count="1" />
			  <Component Subtype="RHS_Plate" Count="1" />
		  </Components>
		  <CriticalComponent Subtype="RHS_Plate" Index="0" />
		  <BuildProgressModels>
			  <Model BuildPercentUpperBound="1.00" File="Models\Models\Cubes\Small\ASL_CustomRamp.mwm" />
		  </BuildProgressModels>

		  <BlockPairName>ASL_CustomRamp90_3</BlockPairName>
		  <MirroringY>Z</MirroringY>
		  <MirroringZ>Y</MirroringZ>
		  <EdgeType>Light</EdgeType>
		  <BuildTimeSeconds>14</BuildTimeSeconds>
		  <DisassembleRatio>1.2</DisassembleRatio>


		  <Subparts>
			  <SubpartDefinition>
				  <Name>ASL_Ramp_90_3</Name>
			  </SubpartDefinition>
		  </Subparts>
		  <OpeningSequence>
			  <Opening>
				  <IDs>0</IDs>
				  <Move>Rotate</Move>
				  <!--Slide for linear-->
				  <RotationAxis>X</RotationAxis>
				  <PivotPosition x="0.00" y="0.00" z="0.00"/>
				  <MaxOpen>-95</MaxOpen>
				  <Speed>90</Speed>
				  <OpenDelay>0</OpenDelay>
				  <CloseDelay>0</CloseDelay>
				  <OpenSound></OpenSound>
				  <CloseSound></CloseSound>
			  </Opening>
		  </OpeningSequence>
		  <PCU>1</PCU>
		  <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
		  <DamagedSound>ParticleHeavyMech</DamagedSound>
		  <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
		  <DestroySound>WepSmallWarheadExpl</DestroySound>

	  </Definition>

